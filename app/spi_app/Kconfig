# For a description of the syntax of this configuration file,
# see kconfig-language.txt in the NuttX tools repository.
#

config LVX_USE_DEMO_CONTEST2026_463_SPI_APP
        bool "Contest 2026 team 463 spi app (shell spi_app command)"
        default n
        ---help---
                Enable the SPI shell command for reading/writing registers
                via SPI bitbang. Provides NSH `spi_app` command:
                  spi_app probe              Probe SPI bus
                  spi_app read  <reg>        Read register
                  spi_app write <reg> <val>  Write register
                  spi_app test               Stability test
