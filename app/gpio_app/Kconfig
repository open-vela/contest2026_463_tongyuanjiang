config LVX_USE_DEMO_CONTEST2026_463_GPIO_APP
        bool "Contest 2026 team 463 gpio app (shell gpio command)"
        default n
        ---help---
                Enable the GPIO shell command for reading/writing arbitrary
                STM32 pins. Provides NSH `gpio_app` command:
                  gpio_app mode  <port><pin> <in|out> [pullup|pulldown]
                  gpio_app read  <port><pin>
                  gpio_app write <port><pin> <0|1>
